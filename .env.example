# ============================================================
# GOOGLE ADS API CREDENTIALS
# Get these from: https://developers.google.com/google-ads/api/docs/get-started/introduction
# ============================================================

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Generated via OAuth flow (use the refresh token generator script)
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# From Google Ads API Center (apply at ads.google.com/intl/en_in/home/tools/manager-accounts/)
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token_here

# Your Google Ads Customer ID (without dashes, e.g. 1234567890)
GOOGLE_CUSTOMER_ID=your_customer_id_here

# ============================================================
# META (FACEBOOK) ADS API CREDENTIALS
# Get these from: https://developers.facebook.com/apps/
# ============================================================

# From Meta for Developers → Your App → Settings → Basic
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# System User Access Token (never expires) from Meta Business Manager
# Business Manager → System Users → Generate Token
META_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Your Meta Ad Account ID (format: act_XXXXXXXXXX)
META_AD_ACCOUNT_ID=act_your_ad_account_id_here

# ============================================================
# APP SECURITY
# ============================================================

# Secret key for session/auth — generate with: openssl rand -base64 32
APP_SECRET=your_random_secret_here

# Optional: Comma-separated list of allowed email domains for team access
# Example: yourdomain.com,partner.com
ALLOWED_EMAIL_DOMAINS=

# Optional: Simple password to protect the dashboard for team
# Leave empty to have no password
DASHBOARD_PASSWORD=
